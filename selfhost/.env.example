# ===== Software Operativo · Campus Experience — configuración del servidor =====
# Copia este archivo como .env y rellena los valores. NO subas el .env a GitHub.

# Puerto interno del servidor (el proxy HTTPS apunta aquí)
PORT=3000
# Carpeta donde se guarda la base de datos (usuarios, horarios, equipos…). Haz copias de seguridad.
DATA_DIR=./data
# Ruta a la aplicación
APP_HTML=./app/index.html

# Detrás de un proxy HTTPS (Caddy, nginx…): 1. Necesario para leer la IP real.
TRUST_PROXY=1
# Cookies solo por HTTPS. Déjalo en 1 en producción.
COOKIE_SECURE=1

# Sesión: se cierra tras X minutos sin uso y como máximo a las X horas
SESSION_IDLE_MIN=480
SESSION_MAX_HOURS=72

# Doble control con Zoho CRM
ZOHO_RECHECK_MIN=30      # cada cuánto se vuelve a comprobar en Zoho durante la sesión
ZOHO_GRACE_HOURS=12      # si Zoho no responde, se acepta la última comprobación correcta de las últimas X horas

# ===== Conexión con Zoho CRM (Self Client) =====
# Centro de datos: .eu si vuestro Zoho es crm.zoho.eu; .com si es crm.zoho.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_API_URL=https://www.zohoapis.eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
